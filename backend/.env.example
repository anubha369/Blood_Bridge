# =============================================================================
# BloodBridge Vision-X Backend Environment Configuration
# =============================================================================

# Server Port & Mode
PORT=5001
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Supabase & PostgreSQL (with PostGIS Extension enabled)
# Obtain from Supabase Project Settings -> Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Groq AI LLM Configuration
# Obtain from https://console.groq.com/keys
# Supported models: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Forms & Google Sheets Webhook Secret
# Set the same secret value in your Google Apps Script Script Properties
GOOGLE_FORM_WEBHOOK_SECRET=your_secure_google_apps_script_secret_token

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
