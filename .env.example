# =============================================================================
# BloodBridge Vision-X Master Environment Configuration Template
# =============================================================================

# Frontend Environment Variables (Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=http://localhost:5001/api

# Backend Supabase / PostgreSQL Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Groq AI LLM Inference
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# RAG Embedding Configuration
EMBEDDING_PROVIDER=tfidf_cosine
EMBEDDING_MODEL=text-embedding-3-small

# Google Forms & Google Sheets Webhook Secrets
GOOGLE_SCRIPT_SECRET=your_secure_google_apps_script_secret_token
GOOGLE_FORM_WEBHOOK_SECRET=your_secure_google_apps_script_secret_token

# Node Server Configuration
PORT=5001
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_change_in_production
